# Copy these lines into .env and fill in your own values. .env is not committed to git.
OPENAI_API_KEY=sk-...

# Shared secret between the Streamlit dashboard and the API (any long random string)
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AIDA_API_KEY=

# Password for signing in to the dashboard
AIDA_UI_PASSWORD=

# Proactive monitoring (checks the machine and opens tickets for new problems)
# AIDA_MONITOR_INTERVAL=300          # seconds between checks; 0 turns scheduled checks off
# AIDA_MONITOR_COOLDOWN=6            # hours before the same problem may open another ticket
# AIDA_MONITOR_DISK_PATHS=/          # comma-separated mount points
# AIDA_MONITOR_DISK_PCT=90
# AIDA_MONITOR_MEM_PCT=10
# AIDA_MONITOR_LOAD_FACTOR=2.0
# AIDA_MONITOR_CERT_HOSTS=example.com,api.example.com:8443
# AIDA_MONITOR_CERT_DAYS=14

# Optional settings
# AIDA_TIMEZONE=America/Los_Angeles
# AIDA_RESTARTABLE_SERVICES=cron,ssh,systemd-resolved,docker
# AIDA_DB_URI=postgresql://aida:aida_password@localhost:55432/aida_kb
