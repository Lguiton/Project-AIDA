# Copy these lines into .env and fill in your own values. .env is not committed to git.
OPENAI_API_KEY=sk-...

# Shared secret between the Streamlit dashboard and the API (any long random string)
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AIDA_API_KEY=

# Password for the first dashboard user, "admin" (created automatically when no users exist).
# After that, manage users and passwords in the dashboard's "Users & Notifications" tab.
AIDA_UI_PASSWORD=

# Proactive monitoring (checks the machine and opens tickets for new problems)
# AIDA_MONITOR_INTERVAL=300          # seconds between checks; 0 turns scheduled checks off
# AIDA_MONITOR_COOLDOWN=6            # hours before the same problem may open another ticket
# AIDA_MONITOR_DISK_PATHS=/          # comma-separated mount points
# AIDA_MONITOR_DISK_PCT=90
# AIDA_MONITOR_MEM_PCT=10
# AIDA_MONITOR_LOAD_FACTOR=2.0
# AIDA_MONITOR_CERT_HOSTS=example.com,api.example.com:8443
# AIDA_MONITOR_CERT_DAYS=14
# AIDA_MONITOR_FAILED_LOGINS=20      # failed logins from one IP (per window) that open a block-IP ticket
# AIDA_MONITOR_LOGIN_WINDOW_HOURS=1

# Windows side of this PC (AIDA in WSL reaches Windows through powershell.exe; nothing to install)
# AIDA_MONITOR_WINDOWS=auto          # auto (on when Windows is reachable) | on | off
# AIDA_WINDOWS_SERVICES=WinDefend,mpssvc,BFE,EventLog,Dnscache,Winmgmt,Spooler   # watched services
# AIDA_WINDOWS_RESTARTABLE_SERVICES=Spooler,BITS,wuauserv,WSearch,W32Time        # services AIDA may restart
# AIDA_WINDOWS_SIGNATURE_DAYS=3      # alert when Defender virus definitions are older than this
# AIDA_POWERSHELL=/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe  # only if not found automatically

# Database backups (the database_backup runbook; schedule it daily under Maintenance)
# AIDA_BACKUP_DIR=backups            # default: the backups folder next to main.py (kept out of git)
# AIDA_DB_CONTAINER=project-aida-pgvector-1   # only if AIDA cannot find the database container itself

# Scheduled maintenance and reports
# AIDA_SCHEDULER_INTERVAL=60         # seconds between schedule checks; 0 turns schedules off
# AIDA_MINUTES_SAVED_PER_TICKET=15   # assumption behind the 'estimated hours saved' report figure

# Notifications (any combination; leave unset to turn off)
# AIDA_NOTIFY_WEBHOOK_URLS=https://hooks.slack.com/services/...,https://....webhook.office.com/...
# AIDA_SMTP_HOST=smtp.gmail.com
# AIDA_SMTP_PORT=587
# AIDA_SMTP_USER=you@example.com
# AIDA_SMTP_PASSWORD=app-password
# AIDA_NOTIFY_EMAIL_TO=ops@example.com
# AIDA_NOTIFY_EVENTS=approval_needed,auto_ticket,fix_failed,escalated
# AIDA_DASHBOARD_URL=http://localhost:8501

# Optional settings
# AIDA_TIMEZONE=America/Los_Angeles
# AIDA_RESTARTABLE_SERVICES=cron,ssh,systemd-resolved,docker
# AIDA_DB_URI=postgresql://aida:aida_password@localhost:55432/aida_kb
